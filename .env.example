# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database file path (format: file:<absolute-or-relative-path>)
DATABASE_URL=file:./db/custom.db

# NextAuth.js configuration (for user authentication — not yet wired up)
# NEXTAUTH_SECRET=  # generate with: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# Sentry error tracking (optional)
# SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider Configuration (optional — Z.ai is built in and needs no key)
# ─────────────────────────────────────────────────────────────────────────────
# The AI Assistant panel in the UI lets users switch providers at runtime.
# These env vars set the SERVER-SIDE DEFAULT; the user's dropdown choice
# overrides per-request.
#
#   AI_PROVIDER=zai | openai | anthropic   (default: zai)
#
# Z.ai (GLM-4.6) — always available, no API key needed (built into the runtime).
#
# OpenAI — set OPENAI_API_KEY to enable in the dropdown.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o            # optional, default gpt-4o
#
# Anthropic Claude — set ANTHROPIC_API_KEY to enable in the dropdown.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022   # optional, default shown
# AI_PROVIDER=zai
